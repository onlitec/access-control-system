generator client {
  provider      = "prisma-client-js"
  // "windows" é exigido pelo instalador Windows (installer/windows)
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HikcentralConfig {
  id                    Int       @id @default(autoincrement())
  apiUrl                String    @map("api_url")
  appKey                String    @map("app_key")
  appSecret             String    @map("app_secret")
  syncEnabled           Boolean   @default(true) @map("sync_enabled")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  config_name           String?
  created_by            String?
  last_sync             DateTime?
  notes                 String?
  sync_interval_minutes Int       @default(60)
  updated_by            String?

  @@map("hikcentral_configs")
}

model Person {
  id                 String            @id @default(uuid())
  firstName          String            @map("first_name")
  lastName           String            @map("last_name")
  phone              String?
  email              String?
  orgIndexCode       String            @map("org_index_code")
  hikPersonId        String?           @unique @map("hik_person_id")
  externalId         String?           @map("external_id")
  departmentId       String?           @map("department_id")
  department         Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // NEW: FK to Unit (building structure — primary path going forward)
  unitId             String?           @map("unit_id")
  unit               Unit?             @relation("PersonToUnit", fields: [unitId], references: [id], onDelete: SetNull)

  photoUrl           String?           @map("photo_url")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime?         @updatedAt @map("updated_at")

  // DEPRECATED fields: Keep during migration for backward compat (2 release cycles)
  // Use unit.block.name instead
  block              String?
  cpf                String?
  rg                 String?
  parkingSpaces      Int?              @map("parking_spaces")
  vehiclePlate       String?           @map("vehicle_plate")
  document_photo_url String?
  is_owner           Boolean?          @default(true)
  notes              String?
  // Use unit.tower.name instead
  tower              String?
  txSerial           String?           @map("tx_serial")
  cardSerial         String?           @map("card_serial")
  // Use unit.number instead
  unit_number        String?
  portalPassword     String?           @map("portal_password")
  residentSessions   ResidentSession[]
  accessAreas        ResidentAccessArea[]
  passbackState      GuaritaPassbackState?
  faceVerification   OnboardingFaceVerification?

  @@index([unitId])
  @@map("persons")
}

// ============ Onboarding: confirmação de CPF + verificação facial ============

model OnboardingFaceVerification {
  id              String    @id @default(uuid())
  personId        String    @unique @map("person_id")
  person          Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  status          String    @default("awaiting_selfie") @map("status")
  // "awaiting_selfie" | "approved" | "pending_admin_review" | "rejected"

  attempts        Int       @default(0) @map("attempts")
  lastSelfieUrl   String?   @map("last_selfie_url") // data:image/jpeg;base64,... (só a última tentativa)
  lastSimilarity  Float?    @map("last_similarity")
  lastAttemptAt   DateTime? @map("last_attempt_at")

  resolvedBy      String?   @map("resolved_by") // User.id do admin que aprovou/rejeitou
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?   @map("resolution_notes")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("onboarding_face_verifications")
}

model Visitor {
  id                 String    @id @default(uuid())
  name               String
  surname            String?
  type               String?   @default("VISITOR")
  certificateType    String?   @map("certificate_type")
  certificateNo      String?   @map("certificate_no")
  email              String?
  phone              String?
  plateNo            String?   @map("plate_no")
  visitStartTime     DateTime  @map("visit_start_time")
  visitEndTime       DateTime  @map("visit_end_time")
  hikVisitorId       String?   @map("hik_visitor_id")
  externalId         String?   @map("external_id")
  status             String?   @default("ACTIVE")
  inviteToken        String?   @map("invite_token")
  // DEPRECATED: guardava o hikPersonId do morador anfitrião p/ herança total
  // de acesso (comportamento antigo). Não recebe mais gravações novas — ver
  // selectedAccessLevels, que é o que o morador realmente escolheu conceder.
  accessLevelId      String?   @map("access_level_id")
  selectedAccessLevels Json?   @map("selected_access_levels")
  createdAt          DateTime  @default(now()) @map("created_at")
  document           String?
  document_photo_url String?
  full_name          String?
  notes              String?
  photo_url          String?
  purpose            String?
  tower              String?
  updated_at         DateTime?
  visiting_resident  String?
  visiting_unit      String?
  visiting_block     String?
  lgpdConsent        Boolean   @default(false) @map("lgpd_consent")
  consentTimestamp   DateTime? @map("consent_timestamp")

  @@map("visitors")
}

model AccessEvent {
  id           String    @id @default(uuid())
  occurredAt   DateTime  @default(now()) @map("occurred_at")
  personName   String    @map("person_name")
  personType   String    @default("visitor") @map("person_type") // "resident" | "visitor" | "provider_condo" | "provider_resident"
  personId     String?   @map("person_id")
  unit         String?   @map("unit") // e.g. "Torre A, Apto 102"
  operatorId   String?   @map("operator_id") // system user who registered the entry
  deviceName   String?   @map("device_name") // videoporteiro or access controller name
  status       String    @default("pending") @map("status") // "authorized" | "denied" | "pending"
  photoUrl     String?   @map("photo_url")
  notes        String?   @map("notes")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Legacy fields preserved for backward compatibility
  eventTime    DateTime  @default(now()) @map("event_time")
  doorName     String?   @map("door_name")
  eventType    String?   @default("face") @map("event_type")
  picUri       String?   @map("pic_uri")

  // Central de Eventos (feed unificado)
  direction    String?   @map("direction") // "in" | "out"
  category     String    @default("access") @map("category") // "access" | "delivery" | "gate" | "alarm" | "device" | "system"
  source       String?   @map("source") // "hikcentral" | "guarita" | "videoporteiro" | "qr_code" | "manual" | "controle_rf"
  metadata     Json?     @map("metadata")

  @@index([occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@map("access_events")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  name               String
  role               String              @default("admin_master")
  status             String              @default("active")
  isProtected        Boolean             @default(false) @map("is_protected")
  lastLoginAt        DateTime?           @map("last_login_at")
  mustChangePassword Boolean             @default(true) @map("must_change_password")
  customPermissions  Json?               @map("custom_permissions")
  createdAt          DateTime            @default(now()) @map("created_at")
  refreshSessions    RefreshSession[]
  sessionAuditEvents SessionAuditEvent[]
  adminAuditEvents   AdminAuditEvent[]

  @@map("users")
}

model RefreshSession {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model SessionAuditEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")
  eventType String   @map("event_type")
  success   Boolean  @default(true)
  sessionId String?  @map("session_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@index([ipAddress, createdAt])
  @@index([userEmail, createdAt])
  @@map("session_audit_events")
}

model AdminAuditEvent {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  userEmail  String?  @map("user_email")
  action     String
  status     String
  ipAddress  String?  @map("ip_address")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userEmail, createdAt])
  @@map("admin_audit_events")
}

model ServiceProvider {
  id                 String   @id @default(uuid())
  fullName           String   @map("full_name")
  companyName        String?  @map("company_name")
  document           String
  phone              String?
  email              String?
  serviceType        String   @map("service_type")
  providerType       String   @default("temporary") @map("provider_type")
  photoUrl           String?  @map("photo_url")
  documentPhotoUrl   String?  @map("document_photo_url")
  tower              String?
  visitingBlock      String?  @map("visiting_block")
  visitingUnit       String?  @map("visiting_unit")
  visitingResident   String?  @map("visiting_resident")
  validFrom          String?  @map("valid_from")
  validUntil         String?  @map("valid_until")
  authorizedUnits    Json?    @map("authorized_units")
  // Níveis de acesso do pool aprovado pelo admin que o morador selecionou
  // para este prestador (ver GrantableAccessLevel). Ainda não é enviado
  // automaticamente ao HikCentral - hoje é só visível pra portaria.
  selectedAccessLevels Json?  @map("selected_access_levels")
  notes              String?
  hikcentralPersonId String?  @map("hikcentral_person_id")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("service_providers")
}

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  color        String?
  hasAddresses Boolean  @default(true) @map("has_addresses")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  persons      Person[]

  @@map("departments")
}

model Tower {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  floors      Int      @default(1)
  blocks      Block[]
  units       Unit[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("towers")
}

model Delivery {
  id            String    @id @default(uuid())
  courierName   String?   @map("courier_name")   // nome do entregador
  company       String?                          // iFood, Mercado Livre, Correios...
  orderRef      String?   @map("order_ref")      // "Pedido 5894", "Vol 2"
  unit          String                           // destino: "Torre A, Apto 804"
  residentId    String?   @map("resident_id")
  status        String    @default("awaiting")   // awaiting | picked_up | returned
  photoUrl      String?   @map("photo_url")
  notes         String?
  receivedById  String?   @map("received_by_id") // operador que registrou
  receivedAt    DateTime  @default(now()) @map("received_at")
  pickedUpAt    DateTime? @map("picked_up_at")
  pickedUpBy    String?   @map("picked_up_by")   // nome de quem retirou
  condominiumId String?   @map("condominium_id") // preparo multi-tenant (Fase G)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, receivedAt(sort: Desc)])
  @@map("deliveries")
}

model SecurityMetricSnapshot {
  id                  String   @id @default(uuid())
  generatedAt         DateTime @map("generated_at")
  periodStart         DateTime @map("period_start")
  periodEnd           DateTime @map("period_end")
  windowHours         Int      @map("window_hours")
  topN                Int      @map("top_n")
  loginAttempts       Int      @map("login_attempts")
  loginFailedAttempts Int      @map("login_failed_attempts")
  loginFailureRate    Float    @map("login_failure_rate")
  topIpAttempts       Json     @default("[]") @map("top_ip_attempts")
  topUserAttempts     Json     @default("[]") @map("top_user_attempts")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([generatedAt])
  @@index([windowHours, generatedAt])
  @@map("security_metric_snapshots")
}

// ============ Multi-Provider Integration Config ============

model IntegrationConfig {
  id           String   @id @default(cuid())
  providerType String   @map("provider_type") // "hikcentral" | "local" | "nice_guarita"
  enabled      Boolean  @default(false)
  config       Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([providerType])
  @@map("integration_configs")
}

// ============ Resident Portal Sessions ============

model ResidentSession {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([personId])
  @@index([expiresAt])
  @@map("resident_sessions")
}

// ============ Hikvision Video Doorbell Devices ============

model DoorbellDevice {
  id        String   @id @default(cuid())
  name      String
  ip        String
  port      Int      @default(80)
  username  String
  password  String
  location  String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("doorbell_devices")
}

// ============ Nice Guarita IP Devices ============

model GuaritaDevice {
  id        String   @id @default(cuid())
  name      String
  ip        String
  port      Int      @default(80)
  location  String?
  enabled   Boolean  @default(true)
  sdkConfig Json?    @map("sdk_config")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("guarita_devices")
}

// ============ CMS Data-Driven: Entity Mappings ============
// Mapeamento universal entre entidades HikCentral e páginas do painel
// Permite que o admin configure dinamicamente quais dados alimentam cada página

model EntityMapping {
  id            String   @id @default(uuid())
  pageRoute     String   @map("page_route") // "/painel/staff", "/painel/prestadores", "/painel/ti"
  entityType    String   @map("entity_type") // "ORGANIZATION", "AREA", "ACCESS_LEVEL", "CUSTOM_FIELD", "FLOOR", "VISITOR_GROUP"
  hikEntityId   String   @map("hik_entity_id") // orgIndexCode, areaIndexCode, privilegeGroupId, fieldId, floorIndexCode, visitorGroupId
  hikEntityName String   @map("hik_entity_name") // Nome legível para exibição rápida no admin
  isActive      Boolean  @default(true) @map("is_active")
  priority      Int      @default(0) // Ordem de aplicação (menor = maior prioridade)
  filterConfig  Json?    @map("filter_config") // Configurações adicionais de filtro (ex: {"operator": "AND", "value": "x"})
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by")

  @@index([pageRoute])
  @@index([entityType])
  @@index([pageRoute, entityType, isActive])
  @@map("entity_mappings")
}

model BackupRun {
  id           String    @id @default(cuid())
  status       String    // "running" | "success" | "failed"
  type         String    // "automatic" | "manual"
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  sizeBytes    BigInt?   @map("size_bytes")
  destination  String?
  errorMessage String?   @map("error_message")
  triggeredBy  String?   @map("triggered_by") // admin user id or "scheduler"
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("backup_runs")
}

model Block {
  id        String   @id @default(cuid())
  name      String
  towerId   String   @map("tower_id")
  tower     Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  units     Unit[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocks")
}

model Unit {
  id            String   @id @default(cuid())
  number        String
  floor         Int?
  status        String   @default("vacant") // "occupied" | "vacant"
  towerId       String   @map("tower_id")
  tower         Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  blockId       String?  @map("block_id")
  block         Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  parkingSpaces Int      @default(0) @map("parking_spaces")
  createdAt     DateTime @default(now()) @map("created_at")

  // Residents in this unit
  persons       Person[] @relation("PersonToUnit")

  @@map("units")
}

model CondominiumSettings {
  id                   String   @id @default("singleton")
  name                 String
  cnpj                 String?
  address              String?
  phone                String?
  email                String?
  logoUrl              String?  @map("logo_url")
  type                 String   @default("vertical")
  antiPassbackEnabled  Boolean  @default(false) @map("anti_passback_enabled")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("condominium_settings")
}

// Configurações de infraestrutura do sistema (SMTP, atualizações) —
// singleton editável pelo painel admin; campos nulos caem no fallback do .env
model SystemSettings {
  id                String   @id @default("singleton")
  smtpHost          String?  @map("smtp_host")
  smtpPort          Int?     @map("smtp_port")
  smtpUser          String?  @map("smtp_user")
  smtpPassword      String?  @map("smtp_password")
  smtpFrom          String?  @map("smtp_from")
  smtpFromName      String?  @map("smtp_from_name")
  updateManifestUrl String?  @map("update_manifest_url")
  // Acesso remoto (WAN): qual URL base entra nos links enviados a moradores
  // e visitantes (onboarding, pré-cadastro). O instalador grava o IP local
  // da rede em APP_URL (.env), que raramente é alcançável de fora - accessMode
  // escolhe entre o IP (LAN/WAN com IP fixo) e um domínio público (DNS/proxy).
  accessMode        String   @default("ip") @map("access_mode") // "ip" | "domain"
  accessUrlIp       String?  @map("access_url_ip")
  accessUrlDomain   String?  @map("access_url_domain")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============ Anti-Passagem Dupla (Guarita IP) ============

model GuaritaPassbackState {
  id         String   @id @default(cuid())
  personId   String   @unique @map("person_id")
  serial     String
  direction  String                       // "IN" | "OUT"
  deviceId   String?  @map("device_id")
  occurredAt DateTime @map("occurred_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("guarita_passback_states")
}

model GuaritaPassbackAlert {
  id         String    @id @default(cuid())
  personId   String?   @map("person_id")
  personName String    @map("person_name")
  serial     String
  deviceId   String?   @map("device_id")
  deviceName String?   @map("device_name")
  unit       String?
  photoUrl   String?   @map("photo_url")
  occurredAt DateTime  @map("occurred_at")
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  @@map("guarita_passback_alerts")
}

model RolePermission {
  id                 String   @id @default(uuid())
  role               String   @unique
  health             Boolean  @default(false)
  containers         Boolean  @default(false)
  backups            Boolean  @default(false)
  logs               Boolean  @default(false)
  integrations       Boolean  @default(false)
  condo              Boolean  @default(false)
  users              Boolean  @default(false)
  permissions        Boolean  @default(false)
  audit              Boolean  @default(false)
  deleteRegistration Boolean  @default(false) @map("delete_registration")
  editRegistration   Boolean  @default(false) @map("edit_registration")
  viewOnly           Boolean  @default(false) @map("view_only")
  editDepartments    Boolean  @default(false) @map("edit_departments")
  manageDevices      Boolean  @default(false) @map("manage_devices")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("role_permissions")
}

// ============ Áreas de Acesso do Condomínio ============

model AccessArea {
  id             String               @id @default(cuid())
  name           String
  description    String?
  icon           String?              @default("🏠")
  isActive       Boolean              @default(true) @map("is_active")
  order          Int                  @default(0)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  residentAccess ResidentAccessArea[]

  @@map("access_areas")
}

model ResidentAccessArea {
  id        String     @id @default(cuid())
  personId  String     @map("person_id")
  areaId    String     @map("area_id")
  grantedAt DateTime   @default(now()) @map("granted_at")
  grantedBy String?    @map("granted_by")
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  area      AccessArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([personId, areaId])
  @@map("resident_access_areas")
}

// ============ Pools de níveis de acesso HikCentral aprovados p/ visitantes/prestadores ============
// O admin cura, no painel de Permissões, quais níveis de acesso do HikCentral
// podem ser concedidos a visitantes e a prestadores (pools separados, únicos
// para o condomínio inteiro). O morador só pode escolher, no pré-cadastro,
// dentre o que estiver aqui como isActive=true - substitui a herança total
// do acesso do próprio morador que existia antes.

model GrantableAccessLevel {
  id               String   @id @default(cuid())
  hikAccessLevelId String   @map("hik_access_level_id") // privilegeGroupId do HikCentral
  name             String
  appliesTo        String   @map("applies_to") // "visitor" | "provider"
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([hikAccessLevelId, appliesTo])
  @@map("grantable_access_levels")
}

model RegistrationRequirement {
  id        String   @id @default(cuid())
  category  String   // "resident" | "visitor" | "condo_provider" | "resident_provider"
  fieldName String   @map("field_name")
  status    String   // "required" | "optional" | "hidden"
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, fieldName])
  @@map("registration_requirements")
}

model Blacklist {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  @@map("blacklist")
}

model AccessSchedule {
  id        String   @id @default(uuid())
  type      String   // "visitor" | "provider"
  dayOfWeek Int      @map("day_of_week") // 0-6
  startTime String   @map("start_time") // "08:00"
  endTime   String   @map("end_time") // "18:00"
  isActive  Boolean  @default(true) @map("is_active")

  @@map("access_schedules")
}
