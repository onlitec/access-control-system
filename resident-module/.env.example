# Servidor
# Endereço de escuta: 127.0.0.1 (só esta máquina, recomendado atrás de proxy/túnel HTTPS) ou 0.0.0.0
HOST=127.0.0.1
PORT=4100
# Endereço público (HTTPS) usado nos links de convite enviados aos visitantes
PUBLIC_URL=https://morador.exemplo.com.br
# Dias de validade padrão de um convite
INVITE_DAYS=7
# Dias sem visita até apagar um visitante salvo (dados e fotos)
SAVED_RETENTION_DAYS=180
# Fuso dos horários enviados ao HikCentral
HIKCENTRAL_TZ_OFFSET=-03:00
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
DATABASE_URL=file:./data/resident.db

# HikCentral OpenAPI (parceiro de integração). Nunca commitar valores reais.
HIK_HOST=https://hikcentral.exemplo.com.br
HIK_APP_KEY=
HIK_APP_SECRET=
HIK_USER_ID=admin
# Aceitar certificado autoassinado do HikCentral local (true/false)
HIK_INSECURE_TLS=false

# Notificações push no celular (gere com: npm run vapid). Vazio = sem push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# Como enviar o código de login: console (só desenvolvimento) | live
NOTIFY_MODE=console
# WhatsApp via Twilio (NOTIFY_MODE=live)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# E-mail via SMTP (NOTIFY_MODE=live)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
