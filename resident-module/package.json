{
    "name": "resident-module",
    "version": "0.1.0",
    "private": true,
    "description": "Módulo do morador integrado ao HikCentral (convites de visitantes, aprovação, família)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/server.js",
        "test": "vitest run",
        "prisma:generate": "prisma generate",
        "vapid": "tsx src/scripts/vapid-keys.ts",
        "prisma:push": "prisma db push",
        "smoke:hik": "tsx src/scripts/smoke-hikcentral.ts",
        "e2e:hik": "tsx src/scripts/e2e-hikcentral.ts",
        "e2e:hik:family": "tsx src/scripts/e2e-hikcentral-family.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^6.9.16",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.0",
        "@types/nodemailer": "^6.4.17",
        "@types/web-push": "^3.6.4",
        "prisma": "^5.22.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    }
}
