[Unit]
Description=OnliAcesso - API (Express + Prisma), porta 3001
Documentation=file:/opt/onliacesso/README.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=onliacesso
Group=onliacesso
WorkingDirectory=/opt/onliacesso/apps/backend-api
EnvironmentFile=/opt/onliacesso/config/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=10
StandardOutput=append:/opt/onliacesso/logs/api.log
StandardError=append:/opt/onliacesso/logs/api.err.log

# Endurecimento: o serviço só precisa escrever em data/, logs/ e backups/.
#
# NoNewPrivileges fica DESLIGADO aqui de propósito: a tela "Serviços" do Admin
# reinicia os processos com `sudo -n systemctl restart <unit>`, e o sudo é um
# binário setuid — com NoNewPrivileges=yes o kernel bloqueia a elevação e o
# botão falha silenciosamente. O poder concedido continua mínimo: a regra em
# /etc/sudoers.d/onliacesso só permite `systemctl restart` dos units do
# OnliAcesso, nada mais.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/onliacesso/data /opt/onliacesso/logs /opt/onliacesso/backups

[Install]
WantedBy=multi-user.target
