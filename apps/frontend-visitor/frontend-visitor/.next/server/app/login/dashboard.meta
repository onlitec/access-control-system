{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/login/layout,_N_T_/login/dashboard/layout,_N_T_/login/dashboard/page,_N_T_/login/dashboard"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/login/dashboard/__PAGE__",
    "/login/dashboard",
    "/login",
    "/_index",
    "/_head"
  ]
}